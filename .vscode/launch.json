{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run KUVHURA Observatory",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/server.js",
            "cwd": "${workspaceFolder}",
            "runtimeArgs": [
                "--env-file-if-exists=${workspaceFolder}/.env"
            ],
            "serverReadyAction": {
                "pattern": "KUVHURA Observatory running on http://0\\.0\\.0\\.0:(\\d+)",
                "uriFormat": "http://localhost:%s",
                "action": "openExternally"
            }
        },
        {
            "name": "Run KUVHURA Forecast Stream",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/stream_server.py",
            "cwd": "${workspaceFolder}",
            "python": "${command:python.interpreterPath}",
            "console": "integratedTerminal",
            "env": {
                "KUVHURA_API_BASE_URL": "http://127.0.0.1:3000"
            },
            "justMyCode": true
        },
        {
            "name": "Attach to Chrome",
            "port": 9222,
            "request": "attach",
            "type": "chrome",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Launch Chrome",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}"
        },

        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}"
        }
    ],
    "compounds": [
        {
            "name": "Run Observatory with Forecast Stream",
            "configurations": [
                "Run KUVHURA Observatory",
                "Run KUVHURA Forecast Stream"
            ],
            "stopAll": true
        }
    ]
}