# Environment variables for KUVHURA Observatory
PORT=3000
GOOGLE_SHEETS_WEB_APP_URL=
GOOGLE_SHEETS_WEB_APP_TOKEN=
GEMINI_API_KEY=
X_BEARER_TOKEN=
YOUTUBE_API_KEY=
REDDIT_API_KEY=
SCRAPER_API_KEY=
# Server-side CARTO basemap API key (kept strictly server-side via /api/maps/tiles proxy)
CARTO_MAPS_API_KEY=
# Absolute path to a persistent disk directory for daily telemetry snapshots
TIMELINE_STORAGE_DIR=
# Local FlareSolverr container endpoint (e.g. http://localhost:8191/v1)
FLARESOLVERR_URL=
# Optional override for published Google Sheets Form responses 1 CSV URL
SURVEY_CSV_URL=




